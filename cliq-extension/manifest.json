{
  "name": "DocDex",
  "version": "1.0.0",
  "description": "AI-powered document indexing and search for WorkDrive and Mail attachments",
  "author": "DocDex Team",
  "homepage": "https://github.com/your-org/docdex",
  "manifest_version": 2,
  "permissions": [
    "chat.bot",
    "chat.command",
    "cliq.user.read",
    "cliq.user.organization.read"
  ],
  "oauth": {
    "scopes": [
      "ZohoWorkDrive.files.READ",
      "ZohoWorkDrive.folders.READ", 
      "ZohoMail.messages.READ",
      "ZohoMail.attachments.READ"
    ]
  },
  "bots": [
    {
      "name": "DocDex Bot",
      "unique_name": "docdex_bot",
      "description": "Search and manage your documents with AI-powered insights",
      "avatar": "icons/icon48.png",
      "webhook": "https://docdex-60058081001.development.catalystserverless.in/server/docdex_io/execute?path=botWebhook",
      "commands": [
        {
          "command": "/docdex",
          "hint": "DocDex commands",
          "description": "Search documents and get AI summaries",
          "usage": "/docdex search <query> | /docdex summarize <file_id> | /docdex help"
        },
        {
          "command": "/docdex-setup",
          "hint": "Setup DocDex",
          "description": "Connect DocDex to your WorkDrive account",
          "usage": "/docdex-setup"
        },
          "description": "Get AI-powered summary of a specific document",
          "usage": "/doc-summary <file-name-or-id>"
        }
      ]
    }
  ],
  "widgets": [
    {
      "name": "Document Explorer",
      "unique_name": "doc_explorer_widget",
      "description": "Browse, search, and manage your documents",
      "type": "applet",
      "source": "web/index.html",
      "icon": "icons/icon48.png",
      "context": "sidebar",
      "height": "medium",
      "width": "medium",
      "permissions": [
        "cliq.user.read"
      ]
    }
  ],
  "webhooks": [
    {
      "name": "bot-webhook",
      "url": "{{CATALYST_APP_URL}}/bot-webhook",
      "subscriptions": [
        "bot.mention",
        "bot.command"
      ]
    }
  ],
  "installation": {
    "callback_url": "{{CATALYST_APP_URL}}/install-callback"
  },
  "icons": {
    "16": "icons/icon48.png",
    "48": "icons/icon48.png", 
    "128": "icons/icon128.png"
  },
  "content_security_policy": {
    "default-src": "'self' https://catalyst.zoho.com https://accounts.zoho.com https://workdrive.zoho.com https://mail.zoho.com https://zia.zoho.com",
    "script-src": "'self' 'unsafe-inline' https://catalyst.zoho.com",
    "style-src": "'self' 'unsafe-inline' https://fonts.googleapis.com",
    "font-src": "https://fonts.gstatic.com",
    "img-src": "'self' data: https:",
    "connect-src": "'self' https://catalyst.zoho.com https://accounts.zoho.com"
  },
  "supported_languages": ["en"],
  "default_language": "en"
}